LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=

# LLM inference — any OpenAI-compatible chat completions endpoint.
# Groq and Cerebras both offer sub-150ms TTFT on Llama 3.3 70B.
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Streaming TTS — direct WebSocket connection to Fish Audio or Sarvam
TTS_PROVIDER=fish
# TTS_PROVIDER=sarvam
TTS_API_KEY=
TTS_VOICE=default
TTS_LANGUAGE=en-IN
TTS_SAMPLE_RATE=24000
# Optional: reconnect to a second provider if TTS_PROVIDER is unreachable
# TTS_FALLBACK_PROVIDER=sarvam
# TTS_FALLBACK_API_KEY=

# Turn-taking arbiter — LLM stage only runs when the regex fast path can't
# confidently decide; defaults to LLM_MODEL/LLM_BASE_URL/LLM_API_KEY above.
# TURN_ARBITER_MODEL=
# TURN_ARBITER_TIMEOUT_MS=100
